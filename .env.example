[TEMPLATE]
# Translation pipeline credentials (scripts/i18n/translate.mjs).
# Copy this file to .env (already gitignored) and fill in your values.

# DeepL API key — used for zh (Chinese simplified) and vi (Vietnamese).
# Free tier: 500,000 characters/month, no credit card needed to sign up.
# Free keys end in ":fx" (script auto-uses the api-free.deepl.com endpoint).
DEEPL_API_KEY=your-key-here

# LibreTranslate — used for bn (Bangla) and ne (Nepali). Self-hosted via
# Docker, no key. Defaults to http://localhost:5000; override only if you
# run it elsewhere:
# LIBRETRANSLATE_URL=http://localhost:5000

# Supabase (free plan) — optional account + cross-device sync. Get these from
# Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only key, used by /api/delete-account to delete the user's account.
# NEVER expose this in client code or NEXT_PUBLIC_ vars. Same page as above,
# under Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
